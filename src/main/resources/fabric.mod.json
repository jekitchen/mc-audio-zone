{
	"schemaVersion": 1,
	"id": "soundsculptor",
	"version": "${version}",
	"name": "Sound Sculptor",
	"description": "Mute or turn down any sound, everywhere or only inside zones you draw, without ever hearing more than vanilla allows. Client-only: nothing is sent to servers.",
	"authors": [
		"maxismagical",
		"Sciencode"
	],
	"contact": {
		"homepage": "https://github.com/jekitchen/mc-sound-sculptor",
		"sources": "https://github.com/jekitchen/mc-sound-sculptor",
		"issues": "https://github.com/jekitchen/mc-sound-sculptor/issues"
	},
	"license": "MIT",
	"icon": "assets/soundsculptor/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"soundsculptor.SoundSculptorClient"
		],
		"modmenu": [
			"soundsculptor.mc.ModMenuEntry"
		]
	},
	"mixins": [
		{
			"config": "soundsculptor.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
