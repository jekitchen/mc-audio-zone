{
	"schemaVersion": 1,
	"id": "audiozone",
	"version": "${version}",
	"name": "Audio Zone",
	"description": "Mute or turn down any sound, everywhere or only inside zones you draw, without ever hearing more than vanilla allows. Client-only: nothing is sent to servers.",
	"authors": [
		"maxismagical",
		"Sciencode"
	],
	"contact": {
		"homepage": "https://github.com/jekitchen/mc-audio-zone",
		"sources": "https://github.com/jekitchen/mc-audio-zone",
		"issues": "https://github.com/jekitchen/mc-audio-zone/issues"
	},
	"license": "MIT",
	"icon": "assets/audiozone/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"audiozone.AudioZoneClient"
		],
		"modmenu": [
			"audiozone.mc.ModMenuEntry"
		]
	},
	"mixins": [
		{
			"config": "audiozone.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
